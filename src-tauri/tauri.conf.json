{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZCOM Mod Manager",
  "version": "0.1.4",
  "identifier": "org.zcommodmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZCOM Mod Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Safe mod management for Star Wars: Zero Company",
    "longDescription": "A dedicated open-source mod manager with Steam discovery, IoStore verification, UE4SS support, conflicts, and checksum-safe deployment.",
    "copyright": "Copyright © 2026 ZCOM Mod Manager contributors",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/retoc"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": [] } },
    "windows": { "nsis": { "installerIcon": "icons/icon.ico" } }
  }
}
